# Optional — only needed if you run the instructor proxy (server/server.mjs).
# Set any subset; students can only choose providers you configure.
#   cd server && npm install && node --env-file=../.env server.mjs

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Port the proxy + static server listens on (default 8787)
PORT=8787
